# Copy to .env (git-ignored) to override the local defaults. Never commit real values.
# The same variables configure the app in other environments.

# Database (backend + docker-compose)
SLUICE_DB_URL=jdbc:postgresql://localhost:5432/sluice
SLUICE_DB_USER=sluice
SLUICE_DB_PASSWORD=sluice

# Spring profiles: empty locally, `prod` in the Docker image, add `migrate` to run migrations and exit.
SPRING_PROFILES_ACTIVE=

# Keycloak admin (docker compose --profile auth, milestone 3)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
