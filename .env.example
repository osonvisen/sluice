# Copy to .env (git-ignored) to override the local defaults. Never commit real values.
# The same variables configure the app in other environments.

# Database (backend + docker-compose)
SLUICE_DB_URL=jdbc:postgresql://localhost:5432/sluice
SLUICE_DB_USER=sluice
SLUICE_DB_PASSWORD=sluice

# Shopify app client secret: verifies webhook signatures (X-Shopify-Hmac-Sha256). Required by the app,
# not by the migrate step. Any value works locally; use the same one to sign test webhooks.
SLUICE_SHOPIFY_WEBHOOK_SECRET=local-dev-secret

# The ERP's base URL. Locally: the stand-in ERP from `docker compose --profile app up` (port 8089).
SLUICE_ERP_BASE_URL=http://localhost:8089

# Login (ADR 0004): the OIDC provider and the web app's confidential client. The values below match
# keycloak/realm-sluice.json and `docker compose --profile auth up`. Not needed with the local-noauth profile.
SLUICE_OIDC_ISSUER_URI=http://localhost:8081/realms/sluice
SLUICE_OIDC_CLIENT_ID=sluice-web
SLUICE_OIDC_CLIENT_SECRET=sluice-web-local-dev-secret

# Spring profiles: empty locally (login with Keycloak), `local-noauth` to work without Keycloak (a fixed dev
# user with both roles; refused together with prod), `prod` in the Docker image, add `migrate` to run
# migrations and exit.
SPRING_PROFILES_ACTIVE=

# Keycloak admin (docker compose --profile auth, milestone 3)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
