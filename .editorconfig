root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4
max_line_length = 140
ktlint_code_style = ktlint_official
# Spring endpoints and tests read better with names like `returns 404 for unknown api path`.
ktlint_function_naming_ignore_when_annotated_with = Test, ParameterizedTest

[*.md]
trim_trailing_whitespace = false
